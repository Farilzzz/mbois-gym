rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function activeTrainer() { return activeRole('trainer'); }
    function activeManager() { return activeRole('manager'); }
    function validTrainer(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function validAssignment(ids) {
      return ids is list && ids.size() == 1 && validTrainer(ids[0]);
    }
    function assigned(clientId) {
      return activeTrainer()
        && request.auth.uid in get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTrainerIds;
    }
    function clientAccess(clientId) { return activeManager() || assigned(clientId); }
    function clientResourceAccess() {
      // Queries for trainers must constrain assignedTrainerIds with array-contains UID.
      return activeManager() || (activeTrainer() && request.auth.uid in resource.data.assignedTrainerIds);
    }
    function noteSchema(data) {
      return data.keys().hasOnly(['note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['note']) && data.note is string
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function noteUpdate() {
      return noteSchema(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'updatedAt']);
    }

    // Roles/profiles are provisioned by trusted administration only.
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || activeManager();
      allow list: if activeManager();
      allow create, delete: if false;
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone']))
        || (activeManager() && resource.data.role == 'trainer'
          && request.resource.data.status in ['active', 'inactive', 'pending']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'displayName', 'phone']));
    }

    match /clients/{clientId} {
      allow get: if clientAccess(clientId);
      allow list: if clientResourceAccess();
      allow create: if request.resource.data.keys().hasAll(['name', 'assignedTrainerIds'])
        && request.resource.data.name is string
        && validAssignment(request.resource.data.assignedTrainerIds)
        && (activeManager() || (activeTrainer() && request.resource.data.assignedTrainerIds == [request.auth.uid]));
      allow update: if clientAccess(clientId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTrainerIds'])
          || (activeManager() && validAssignment(request.resource.data.assignedTrainerIds)));
      allow delete: if activeManager() || assigned(clientId);

      match /packages/{packageId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && request.resource.data.keys().hasAll(['totalSessions', 'completedCount', 'status'])
          && request.resource.data.totalSessions is int && request.resource.data.totalSessions > 0
          && request.resource.data.completedCount == 0 && request.resource.data.status == 'active';
        // A client cannot forge the quota counter, even inside a transaction.
        allow update: if clientAccess(clientId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['completedCount', 'totalSessions'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status == 'active' && request.resource.data.status == 'closed'));
        allow delete: if false;
      }
      match /sessions/{sessionId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && request.resource.data.keys().hasAll(['packageIntId', 'sessionNumber', 'scheduledTime', 'status'])
          && request.resource.data.packageIntId is int
          && request.resource.data.sessionNumber is int && request.resource.data.sessionNumber > 0
          && request.resource.data.scheduledTime is timestamp
          && request.resource.data.status == 'scheduled'
          && !('completedAt' in request.resource.data);
        // Completion plus package quota requires a trusted backend. Client SDK writes fail closed.
        allow update: if clientAccess(clientId)
          && resource.data.status == 'scheduled'
          && request.resource.data.status in ['scheduled', 'cancelled']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['packageIntId', 'sessionNumber', 'completedAt']);
        allow delete: if false;
      }
      match /workouts/{workoutId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /evaluations/{evaluationId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /assessments/{assessmentId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /progress_measurements/{measurementId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /assignment_history/{historyId} {
        allow read: if clientAccess(clientId);
        allow create: if activeManager()
          && request.resource.data.keys().hasAll(['fromTrainerId', 'toTrainerId'])
          && request.resource.data.fromTrainerId is string
          && validTrainer(request.resource.data.toTrainerId);
        allow update, delete: if false;
      }
    }
    match /pt_packages/{packageId} { allow read, write: if false; }
    match /workout_logs/{logId} { allow read, write: if false; }
    match /exercise_catalog/{exerciseId} {
      allow read: if activeTrainer() || activeManager();
      allow create, update: if activeManager()
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string;
      allow delete: if activeManager();
    }
    match /package_sales/{saleId} {
      allow read: if activeManager() || (activeTrainer() && resource.data.trainerId == request.auth.uid);
      allow create: if (activeManager() || activeTrainer())
        && request.resource.data.keys().hasAll(['clientId', 'clientName', 'trainerId', 'trainerName', 'tierName', 'sessionsCount', 'durationWeeks', 'price', 'status'])
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.sessionsCount is int && request.resource.data.sessionsCount > 0
        && request.resource.data.status in ['valid', 'refunded']
        && (activeManager() || request.resource.data.trainerId == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
