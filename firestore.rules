rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function activeTrainer() { return activeRole('trainer'); }
    function activeManager() { return activeRole('manager'); }
    function validTrainer(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'trainer'
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function validAssignment(ids) {
      return ids is list && ids.size() == 1 && validTrainer(ids[0]);
    }
    function assigned(clientId) {
      return activeTrainer()
        && request.auth.uid in get(/databases/$(database)/documents/clients/$(clientId)).data.assignedTrainerIds;
    }
    function clientAccess(clientId) { return assigned(clientId); }
    function clientResourceAccess() {
      // Queries for trainers must constrain assignedTrainerIds with array-contains UID.
      return activeTrainer() && request.auth.uid in resource.data.assignedTrainerIds;
    }
    function noteSchema(data) {
      return data.keys().hasOnly(['note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['note']) && data.note is string
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    // Repository workout records are one nested document; permit their full
    // operational payload while protecting immutable ownership and timestamps.
    function workoutSchema(data) {
      return data.keys().hasOnly(['id', 'logId', 'clientIntId', 'packageIntId', 'sessionIntId', 'performedAt', 'notes', 'totalVolume', 'exercises', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['notes']) && data.notes is string
        && (!('exercises' in data) || data.exercises is list)
        && (!('totalVolume' in data) || data.totalVolume is number)
        && (!('performedAt' in data) || data.performedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function workoutUpdate() {
      return workoutSchema(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'sessionIntId', 'totalVolume', 'exercises', 'updatedAt']);
    }
    function evaluationSchema(data) {
      return data.keys().hasOnly(['id', 'evalId', 'packageIntId', 'finalWeightKg', 'bodyFatStart', 'bodyFatEnd', 'muscleStart', 'muscleEnd', 'armRight', 'armLeft', 'thighRight', 'thighLeft', 'achievement', 'evaluation', 'recommendation', 'conclusion', 'finalizedAt', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAny(['note', 'evaluation', 'conclusion', 'achievement'])
        && (!('finalizedAt' in data) || data.finalizedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
    function noteUpdate() {
      return noteSchema(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'updatedAt']);
    }
    function evaluationUpdate() {
      return evaluationSchema(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finalWeightKg', 'bodyFatStart', 'bodyFatEnd', 'muscleStart', 'muscleEnd', 'armRight', 'armLeft', 'thighRight', 'thighLeft', 'achievement', 'evaluation', 'recommendation', 'conclusion', 'updatedAt']);
    }

    function isValidSessionCompletion(clientId, sessionId) {
      let pkgDocId = ('packageDocId' in request.resource.data)
        ? request.resource.data.packageDocId
        : (('packageDocId' in resource.data) ? resource.data.packageDocId : null);
      let pkgRef = /databases/$(database)/documents/clients/$(clientId)/packages/$(pkgDocId);
      let pkgBefore = get(pkgRef).data;
      let pkgAfter = getAfter(pkgRef).data;

      return pkgDocId != null
        && exists(pkgRef)
        && pkgBefore.status == 'active'
        && pkgBefore.completedCount < pkgBefore.totalSessions
        && pkgAfter.completedCount == pkgBefore.completedCount + 1
        && (pkgAfter.completedCount < pkgBefore.totalSessions
            ? pkgAfter.status == 'active'
            : pkgAfter.status == 'closed')
        && ('lastCompletedSessionId' in pkgAfter && pkgAfter.lastCompletedSessionId == sessionId);
    }

    function isValidPackageQuotaIncrement(clientId, packageId) {
      let sId = ('lastCompletedSessionId' in request.resource.data)
        ? request.resource.data.lastCompletedSessionId
        : null;
      let sessionRef = /databases/$(database)/documents/clients/$(clientId)/sessions/$(sId);
      let sessionBefore = get(sessionRef).data;
      let sessionAfter = getAfter(sessionRef).data;

      return sId != null
        && exists(sessionRef)
        && sessionBefore.status == 'scheduled'
        && sessionAfter.status == 'completed'
        && (('packageDocId' in sessionAfter && sessionAfter.packageDocId == packageId)
            || ('packageIntId' in sessionAfter && 'id' in resource.data && sessionAfter.packageIntId == resource.data.id));
    }

    // Roles/profiles are provisioned by trusted administration only.
    match /users/{uid} {
      // Profiles contain private contact/body data; roster uses projections.
            allow get: if signedIn() && request.auth.uid == uid;
            allow list: if false;
      allow create, delete: if false;
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'heightCm', 'weightKg', 'specialization',
            'experienceYears', 'certifications', 'bio', 'photoUrl'
          ]))
        || (activeManager() && resource.data.role == 'trainer'
          && request.resource.data.status in ['active', 'inactive', 'pending']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'displayName', 'phone']));
    }

    match /clients/{clientId} {
      allow get: if clientAccess(clientId);
      allow list: if clientResourceAccess();
      allow create: if request.resource.data.keys().hasAll(['name', 'assignedTrainerIds'])
        && request.resource.data.name is string
        && validAssignment(request.resource.data.assignedTrainerIds)
        && (activeManager() || (activeTrainer() && request.resource.data.assignedTrainerIds == [request.auth.uid]));
      allow update: if (activeManager() || clientAccess(clientId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTrainerIds'])
          || (activeManager() && validAssignment(request.resource.data.assignedTrainerIds)));
      allow delete: if false;

      match /packages/{packageId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && request.resource.data.keys().hasAll(['totalSessions', 'completedCount', 'status'])
          && request.resource.data.totalSessions is int && request.resource.data.totalSessions > 0
          && request.resource.data.completedCount == 0 && request.resource.data.status == 'active';
        allow update: if clientAccess(clientId)
          && (
            (
              resource.data.status == 'active'
              && request.resource.data.status in ['active', 'closed', 'cancelled']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'closedAt', 'cancelledAt', 'cancelledBy', 'cancelReason', 'updatedAt'
              ])
            )
            ||
            (
              resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'completedCount', 'status', 'lastCompletedSessionId', 'closedAt', 'updatedAt'
              ])
              && request.resource.data.completedCount == resource.data.completedCount + 1
              && request.resource.data.completedCount <= resource.data.totalSessions
              && (request.resource.data.completedCount == resource.data.totalSessions
                  ? request.resource.data.status == 'closed'
                  : request.resource.data.status == 'active')
              && isValidPackageQuotaIncrement(clientId, packageId)
            )
          );
        allow delete: if false;
      }
      match /sessions/{sessionId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && request.resource.data.keys().hasAll(['packageIntId', 'sessionNumber', 'scheduledTime', 'status'])
          && request.resource.data.packageIntId is int
          && request.resource.data.sessionNumber is int && request.resource.data.sessionNumber > 0
          && request.resource.data.scheduledTime is timestamp
          && request.resource.data.status == 'scheduled'
          && !('completedAt' in request.resource.data);
        allow update: if clientAccess(clientId)
          && (
            (
              resource.data.status == 'scheduled'
              && request.resource.data.status in ['scheduled', 'cancelled']
              && request.resource.data.scheduledTime is timestamp
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'scheduledTime', 'notes', 'updatedAt',
                'rescheduledAt', 'rescheduledBy', 'rescheduleReason',
                'cancelledAt', 'cancelledBy', 'cancelReason'
              ])
            )
            ||
            (
              resource.data.status == 'scheduled'
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt is timestamp
              && request.resource.data.clientSignatureStatus == 'verified'
              && request.resource.data.coachSignatureStatus == 'verified'
              && request.resource.data.clientSignatureStrokes is list
              && request.resource.data.clientSignatureStrokes.size() > 0
              && request.resource.data.clientSignatureStrokes[0] is map
              && request.resource.data.clientSignatureStrokes[0].keys().hasAll(['points'])
              && request.resource.data.clientSignatureStrokes[0].points is list
              && request.resource.data.coachSignatureStrokes is list
              && request.resource.data.coachSignatureStrokes.size() > 0
              && request.resource.data.coachSignatureStrokes[0] is map
              && request.resource.data.coachSignatureStrokes[0].keys().hasAll(['points'])
              && request.resource.data.coachSignatureStrokes[0].points is list
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['packageIntId', 'sessionNumber', 'scheduledTime'])
              && isValidSessionCompletion(clientId, sessionId)
            )
          );
        allow delete: if false;
      }
      match /workouts/{workoutId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && (noteSchema(request.resource.data) || workoutSchema(request.resource.data))
          && (!('logId' in request.resource.data) || request.resource.data.logId == workoutId);
        allow update: if clientAccess(clientId) && (noteUpdate() || workoutUpdate());
        allow delete: if clientAccess(clientId);
      }
      match /evaluations/{evaluationId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId)
          && (noteSchema(request.resource.data) || evaluationSchema(request.resource.data))
          && (!('evalId' in request.resource.data) || request.resource.data.evalId == evaluationId);
        allow update: if clientAccess(clientId) && (noteUpdate() || evaluationUpdate());
        allow delete: if false;
      }
      match /assessments/{assessmentId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /progress_measurements/{measurementId} {
        allow read: if clientAccess(clientId);
        allow create: if clientAccess(clientId) && noteSchema(request.resource.data);
        allow update: if clientAccess(clientId) && noteUpdate();
        allow delete: if false;
      }
      match /assignment_history/{historyId} {
        allow read: if clientAccess(clientId);
        allow create: if activeManager()
          && request.resource.data.keys().hasAll(['fromTrainerId', 'toTrainerId'])
          && request.resource.data.fromTrainerId is string
          && validTrainer(request.resource.data.toTrainerId);
        allow update, delete: if false;
      }
    }
    // Trusted backend projection. Client SDKs can only read it as active managers.
    match /manager_dashboard/{periodId} {
      allow read: if activeManager();
      allow write: if false;
      match /trainers/{trainerId} {
        allow read: if activeManager();
        allow write: if false;
        match /clients/{clientId} {
          allow read: if activeManager();
          allow write: if false;
          match /attendance/{attendanceId} {
            allow read: if activeManager();
            allow write: if false;
          }
        }
      }
    }
    match /pt_packages/{packageId} { allow read, write: if false; }
    match /workout_logs/{logId} { allow read, write: if false; }
    match /exercise_catalog/{exerciseId} {
      allow read: if activeTrainer() || activeManager();
      allow create, update: if activeManager()
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.name is string;
      allow delete: if activeManager();
    }
    // Financial records are a trusted backend-only ledger. A client SDK may read
    // only its own existing sale; it must never choose a price, paid status, or
    // another client's identity. Cloud Functions/Admin SDK validates ownership,
    // official pricing, payment status, and idempotency before writing.
    match /package_sales/{saleId} {
      allow read: if activeManager() || (activeTrainer() && resource.data.trainerId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
